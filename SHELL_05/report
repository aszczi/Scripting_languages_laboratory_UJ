#!/usr/bin/env bash

set -euo pipefail

export LC_ALL=C #aby odczytac liczby z kropka a nie przecinkiem

wypisz_blad() {
    echo "report: $*" >&2   
}

wypisz_uzycie_i_zakoncz() {
    wypisz_blad "uzycie: $0 WYNIKI_TSV KONFIG_JSON"
    exit 1
}

odczytaj_prog_zaliczenia() {
    jq -r '.passing_score' "$plik_konfiguracji" #wypisanie surowej wartosci
}

odczytaj_grupy() {
    jq -r '.groups[]' "$plik_konfiguracji" #kazdy elem w osobnej linii
}

wypisz_raport_grupy() {
    local grupa=$1

    #-F '\t' rozdzielamy kolumny tabulatorem, przekazujemy zmienna z basha do awk, operujac na pierwszej $1 i trzeciej $3 kolumnie
    awk -F '\t' -v grupa="$grupa" -v prog_zaliczenia="$prog_zaliczenia" '
        $1 == grupa {
            liczba_studentow++
            suma_punktow += $3
            if ($3 >= prog_zaliczenia) zaliczyli++
        }
        END {
            srednia = (liczba_studentow > 0) ? suma_punktow / liczba_studentow : 0

            print  "Group " grupa ":"
            printf "Students: %d\n",  liczba_studentow
            printf "Passed: %d\n",    zaliczyli
            printf "Failed: %d\n",    liczba_studentow - zaliczyli
            printf "Average: %.2f\n", srednia      # %.2f – 2 miejsca po kropce
        }
    ' "$plik_wynikow"
}


[ "$#" -eq 2 ] || wypisz_uzycie_i_zakoncz 

plik_wynikow=$1
plik_konfiguracji=$2

for plik in "$plik_wynikow" "$plik_konfiguracji"; do
    [ -r "$plik" ] || { wypisz_blad "nie mozna odczytac pliku: $plik"; exit 1; }  #sprawdzmy czy plik istnieje i da sie go czytac
done

prog_zaliczenia=$(odczytaj_prog_zaliczenia) || { wypisz_blad "niepoprawny JSON: $plik_konfiguracji"; exit 1; }

czy_pierwsza_grupa=true

#IFS aby nie obcinać spacji, read -r – nie traktuje "\" jako znaku specjalnego
odczytaj_grupy | while IFS= read -r grupa; do
    [ "$czy_pierwsza_grupa" = true ] || echo
    czy_pierwsza_grupa=false

    wypisz_raport_grupy "$grupa"
done
